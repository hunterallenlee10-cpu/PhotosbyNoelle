# Private preview by default. Set to true only at launch (removes noindex, opens robots.txt, adds sitemap).
PUBLIC_LAUNCH=false
# Canonical origin, used for canonical URLs, OG images, JSON-LD and the sitemap.
SITE_URL=https://photosbynoelle.vercel.app

# Inquiry email via Resend (preferred)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Fallback when Resend isn't configured, e.g. https://formspree.io/f/abcdwxyz
FORMSPREE_ENDPOINT=
