---
// The verse that opens each gallery, set large and revealed line by line, then out of the way.
interface Props { text: string; reference: string; intro?: string }
const { text, reference, intro } = Astro.props;
---
<section class="scripture wrap" data-scripture>
  <blockquote>
    <p class="display verse" data-verse>{text}</p>
    <footer class="ref label">{reference}</footer>
  </blockquote>
  {intro && <p class="intro lead" data-reveal>{intro}</p>}
</section>

<style>
  .scripture { padding-top: var(--s-8); padding-bottom: var(--s-7); display: grid; gap: var(--s-6); }
  blockquote { display: grid; gap: var(--s-5); }
  .verse { font-size: calc(clamp(2.5rem, 6.4vw, 6rem) * max(var(--d-scale), 0.7)); max-width: 1180px; text-wrap: balance; }
  .ref { color: var(--accent-text); font-size: 0.9rem; }
  .intro { color: var(--fg-2); max-width: 46ch; }
  .verse :global(.line) { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .verse :global(.line > span) { display: inline-block; }
</style>

<script>
  // Line-by-line reveal with SplitText. Text is fully visible without JS or under reduced motion.
  const el = document.querySelector<HTMLElement>('[data-verse]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    Promise.all([import('gsap'), import('gsap/SplitText')]).then(async ([{ gsap }, { SplitText }]) => {
      gsap.registerPlugin(SplitText);
      await document.fonts.ready;
      SplitText.create(el, {
        type: 'lines',
        mask: 'lines',
        aria: 'none', // lines keep whole words, so the text reads normally; no aria-label on a <p>
        autoSplit: true,
        onSplit: (self) =>
          gsap.from(self.lines, { yPercent: 105, duration: 1.1, ease: 'expo.out', stagger: 0.09, delay: 0.15 }),
      });
    });
  }
</script>
